// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  engineType = "binary"

}

datasource db {
  provider = "postgresql"
}

model Synopsis {
  id          Int      @id @default(autoincrement())
  title       String
  studentName String
  description String?
  stream      String   // e.g., Marketing, Finance, Operations, etc.
  year        Int      // Batch year or submission year
  researchArea String?  // e.g., Digital Marketing, Consumer Behavior, etc.
  status      String   @default("submitted") // draft, submitted, approved, published
  advisor     String?  // Faculty advisor name
  filePath    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// PhD seminars (pre-synopsis / pre-submission seminars and open defences).
// Gmail-fed entries arrive as drafts and only show on the site once published.
model Seminar {
  id          Int      @id @default(autoincrement())
  kind        String   // "pre-synopsis" | "open-defence"
  scholar     String
  title       String
  guide       String?
  date        String?  // YYYY-MM-DD (IST); drafts may not have one yet
  time        String?  // as written on the notice, e.g. "2.30 PM"
  venue       String?
  meetingLink String?
  status      String   @default("draft") // "draft" | "published" | "rejected"
  source      String   @default("manual") // "manual" | "gmail"
  sourceId    String?  @unique // Gmail message id, so a notice is only added once
  rawText     String?  // text read from the notice, kept for checking drafts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, date])
}
